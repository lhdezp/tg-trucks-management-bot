# Token del bot creado con @BotFather.
BOT_TOKEN=123456789:AA...

# IDs de Telegram de los administradores, separados por comas.
ADMIN_IDS=123456789,987654321

# Ruta del archivo SQLite.
DB_PATH=data/bot.db

# Zona horaria IANA usada para fechas, semanas y reportes automaticos.
TIMEZONE=America/Argentina/Buenos_Aires

# Moneda y unidad de peso usadas en los mensajes y reportes.
CURRENCY=$
WEIGHT_UNIT=kg

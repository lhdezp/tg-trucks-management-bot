# Token del bot creado con @BotFather.
BOT_TOKEN=123456789:AA...

# IDs de Telegram de los administradores, separados por comas.
ADMIN_IDS=123456789,987654321

# Ruta del archivo SQLite.
DB_PATH=data/bot.db

# Zona horaria IANA usada para fechas, semanas y reportes automaticos.
TIMEZONE=America/Argentina/Buenos_Aires

# Moneda y unidad de peso usadas en los mensajes y reportes.
CURRENCY=$
WEIGHT_UNIT=kg

# API key de Google AI Studio para leer montos de tickets con Gemini.
# Si queda vacia, los tickets se guardan sin monto automatico.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Credenciales OAuth2 de usuario para subir reportes semanales a Google Drive.
# Obtene el refresh token ejecutando: scripts/get_drive_token.py
# (ver README o instrucciones del script). Si estan vacias, la subida se omite.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID de la carpeta de Drive donde se guardan los reportes. Debe ser una carpeta
# con permiso de edicion para el usuario dueño de las credenciales OAuth2.
GOOGLE_DRIVE_FOLDER_ID=
